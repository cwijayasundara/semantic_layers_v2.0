# What kind of claim is the first mitigation about title-metadata-svc during the incident, and did it come before anyone named a root cause?
# The poster's handle is set by the chat renderer, not the scenario, so it is not projected.
PREFIX ops:  <https://kg.local/ops#>
PREFIX team: <https://kg.local/team#>
PREFIX inc:  <https://kg.local/inc#>
PREFIX chat: <https://kg.local/chat#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX apps: <https://kg.local/app/application/>
SELECT DISTINCT ?kind ?app ?beforeRootCause WHERE {
  {
    SELECT (MIN(?t0) AS ?first) WHERE {
      ?m0 a ops:Mitigation ; chat:about apps:title-metadata-svc ; ops:atTime ?t0 .
      FILTER(?t0 >= "2026-10-14T19:00:00Z"^^xsd:dateTime && ?t0 < "2026-10-15T01:00:00Z"^^xsd:dateTime)
    }
  }
  ?m a ops:Mitigation ; chat:about ?app ; ops:atTime ?first ;
     chat:claimKind/skos:notation ?kind .
  FILTER(?app = apps:title-metadata-svc)
  BIND(NOT EXISTS {
    ?rc chat:claimKind/skos:notation "root_cause" ; ops:atTime ?rt .
    FILTER(?rt >= "2026-10-14T19:00:00Z"^^xsd:dateTime && ?rt < ?first)
  } AS ?beforeRootCause)
}
