# How many past SEV2 incidents do api-gateway deployments explain, and what share of all SEV2s is that?
PREFIX ops:  <https://kg.local/ops#>
PREFIX team: <https://kg.local/team#>
PREFIX inc:  <https://kg.local/inc#>
PREFIX chat: <https://kg.local/chat#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX apps: <https://kg.local/app/application/>
SELECT ?support ?frequency WHERE {
  ?pattern a ops:Pattern ; ops:onApplication apps:api-gateway ;
           ops:causeKind/skos:notation "deployment" ; ops:severity/skos:notation "SEV2" ;
           ops:support ?support ; ops:frequency ?frequency .
}
