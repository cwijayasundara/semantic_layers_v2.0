# Which applications were named in hypotheses that were later retracted during the incident?
PREFIX ops:  <https://kg.local/ops#>
PREFIX team: <https://kg.local/team#>
PREFIX inc:  <https://kg.local/inc#>
PREFIX chat: <https://kg.local/chat#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX apps: <https://kg.local/app/application/>
SELECT DISTINCT ?app WHERE {
  ?retraction chat:retracts ?h ; ops:atTime ?rt .
  ?h a ops:Hypothesis ; chat:about ?app ; ops:atTime ?ht .
  ?app a ops:Application .
  FILTER(?ht >= "2026-10-14T19:00:00Z"^^xsd:dateTime && ?ht < "2026-10-15T01:00:00Z"^^xsd:dateTime)
  FILTER(?rt >= ?ht)
}
