# How many changes of each kind happened between the window start and the as_of cutoff?
# requires: changes
# as_of: investigator question, bounded by the R21 cutoff 2026-10-14T23:00:00Z.
# Counts renderer-side changes too (deploy-shipped commits).
PREFIX ops:  <https://kg.local/ops#>
PREFIX team: <https://kg.local/team#>
PREFIX inc:  <https://kg.local/inc#>
PREFIX chat: <https://kg.local/chat#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX apps: <https://kg.local/app/application/>
SELECT ?kind (COUNT(DISTINCT ?change) AS ?n) WHERE {
  ?change a/rdfs:subClassOf* ops:Change ; ops:changeKind/skos:notation ?kind ; ops:atTime ?t .
  FILTER(?t >= "2026-10-14T19:00:00Z"^^xsd:dateTime && ?t < "2026-10-14T23:00:00Z"^^xsd:dateTime)
}
GROUP BY ?kind
