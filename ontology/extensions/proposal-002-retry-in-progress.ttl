# Proposal for error_templates
# Covers "Retrying <*> (attempt <*>/<*>)", i.e. retries still in flight, as opposed to the existing retry_exhausted category where the client has already given up on its budget.
# example: Retrying <*> (attempt <*>/<*>)

@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix ops: <https://kg.local/ops#> .
@prefix app: <https://kg.local/app#> .
@prefix team: <https://kg.local/team#> .
@prefix infra: <https://kg.local/infra#> .
@prefix chg: <https://kg.local/chg#> .
@prefix exp: <https://kg.local/exp#> .
@prefix met: <https://kg.local/met#> .
@prefix log: <https://kg.local/log#> .
@prefix trc: <https://kg.local/trc#> .
@prefix alrt: <https://kg.local/alrt#> .
@prefix inc: <https://kg.local/inc#> .
@prefix chat: <https://kg.local/chat#> .
@prefix ecat:  <https://kg.local/log/error_category/> .
@prefix ckind: <https://kg.local/chg/change_kind/> .

ecat:retry_in_progress a skos:Concept ;
    skos:inScheme <https://kg.local/log/scheme/error_category> ;
    skos:topConceptOf <https://kg.local/log/scheme/error_category> ;
    skos:notation "retry_in_progress" ;
    skos:prefLabel "Retry in progress"@en ;
    skos:definition "A failed operation is being retried; the retry budget is not yet exhausted."@en .
<https://kg.local/log/scheme/error_category> skos:hasTopConcept ecat:retry_in_progress .
